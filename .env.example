# Chế độ online (docker compose). Sao chép thành .env (đã gitignore) và điền.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=model-name
LLM_API_KEY=
# Tuỳ chọn
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# DATA_DIR=./data
# DATAMATE_WORKERS=2
# Chi phí (USD / 1 triệu token) ghi vào events.jsonl
# LLM_PRICE_INPUT=0.27
# LLM_PRICE_OUTPUT=1.10
# Tracing Langfuse (bật khi có đủ hai khoá)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_LOG_PROMPTS=0
